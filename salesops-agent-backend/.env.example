# ── Database (Neon Postgres) ──────────────────────────────────────────────
# Use the asyncpg driver for the FastAPI app:
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── ERPNext ──────────────────────────────────────────────────────────────
ERPNEXT_BASE_URL=https://erp.softechglobalservices.com
ERPNEXT_API_TOKEN=your_api_key:your_api_secret
# ── Google Credentials (for Places & Calendar API) ──────────────────────────────────────
GOOGLE_PLACES_API_KEY=""
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Note: Used mainly for the setup script now, actual refresh tokens are stored in the DB
GOOGLE_CALENDAR_REFRESH_TOKEN=""

# ── Security ────────────────────────────────────────────────────────────────────────────
# Used to encrypt refresh tokens in the database.
# Generate a new key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=""

GEMINI_API_KEY=apikey
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

# ── Neon Auth ──
NEON_AUTH_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json

GMAIL_USER=
GMAIL_APP_PASSWORD=